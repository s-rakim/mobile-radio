<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Plain HTTP is allowed because a home music server usually lives at an address like
        http://192.168.1.20:4533, and that address is only known once the listener types it in.
        Every public catalogue Spitify talks to is HTTPS anyway.
    -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>

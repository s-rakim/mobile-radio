<resources>
    <style name="Theme.Spitify" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/spitify_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Spitify.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/spitify_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Spitify</item>
    </style>
</resources>

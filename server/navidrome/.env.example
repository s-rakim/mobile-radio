# Folder on your computer that holds your music. Navidrome only reads it.
# Windows example: MUSIC_DIR=C:/Users/you/Music
# Linux / macOS example: MUSIC_DIR=/home/you/Music
MUSIC_DIR=./music

# Linux only: your user and group id (run `id -u` and `id -g`).
# Leave as-is on Windows and macOS.
PUID=1000
PGID=1000
